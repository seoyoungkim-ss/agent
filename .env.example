# docker-compose.yml이 읽는 환경변수. 실제 배포 시 이 파일을 .env로 복사해 값을 채운다.
# .env는 절대 커밋하지 않는다 (PRD 1.2 / 9.5).

POSTGRES_USER=cafeteria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cafeteria

# ingestion-tool(운영자 PC)이 /api/ingest/* 호출 시 사용하는 토큰과 동일해야 한다.
INGEST_API_TOKEN=change-me

# PRD 8: 사내 LLM API. 비워두면 Agent 채팅/월간 VOE 클러스터링이 모의(mock) 응답으로 동작한다.
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_API_KEY=

# PRD 7.1: 기상청 ASOS 일자료(data.go.kr). 비워두면 과거 날씨-식수 상관 분석 카드가
# "데이터 없음" 상태로 표시되고, CSV 수동 임포트(scripts/import_weather_csv.py)로 대체 가능하다.
KMA_WEATHER_BASE_URL=https://apis.data.go.kr/1360000/AsosDalyInfoService
KMA_WEATHER_API_KEY=
KMA_WEATHER_STATION_ID=119

APP_PORT=8000
